{
  "name": "the-frontend-strikes-back",
  "version": "0.0.1",
  "description": "2026 talk on 'The Frontend Strikes Back: WebMCP and The Agent-Ready Browser'",
  "type": "module",
  "config": {
    "cdp_port": "9333"
  },
  "scripts": {
    "dev": "npx serve",
    "cdp": "open -na 'Google Chrome' --args --remote-debugging-port=$npm_package_config_cdp_port --remote-allow-origins='*' --user-data-dir=/tmp/tfsb-chrome-cdp --no-first-run --no-default-browser-check http://localhost:3000",
    "cdp:stop": "pkill -f tfsb-chrome-cdp; rm -rf /tmp/tfsb-chrome-cdp",
    "test": "CDP_URL=${CDP_URL:-http://127.0.0.1:$npm_package_config_cdp_port} node --test \"test/*.test.js\"",
    "qr": "node scripts/gen-qr.mjs",
    "lint": "eslint . --fix",
    "pretty": "prettier . --write",
    "format": "npm run lint && npm run pretty"
  },
  "license": "MIT",
  "devDependencies": {
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.6.2",
    "uqr": "^0.1.3"
  }
}
